{
    "name": "@minima-vue/icons",
    "version": "1.0.2",
    "description": "Minima Vue icon library",
    "author": "Emre Karahan<emre.karahan@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/minima-vue/minima-vue.git",
        "directory": "icons"
    },
    "homepage": "https://github.com/minima-vue/minima-vue/tree/main/minima-vue3/icons",
    "bugs": {
        "url": "https://github.com/minima-vue/minima-vue/issues"
    },
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup && npm run build:types",
        "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist",
        "dev": "tsup --watch",
        "generate": "toolbox icons -o './src/components'",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "vue": "^3.0.0"
    },
    "devDependencies": {
        "@minima-vue/toolbox": "file:../toolbox",
        "esbuild-plugin-vue": "^0.2.4",
        "fs-extra": "^11.2.0",
        "glob": "^10.3.10",
        "hash-sum": "^2.0.0",
        "tsup": "^8.0.2",
        "typescript": "^5.0.0",
        "vue": "^3.4.0",
        "vue-tsc": "^2.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}

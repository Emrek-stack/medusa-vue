{
  "name": "@minima-vue/toolbox",
  "version": "1.0.5",
  "description": "CLI tool for importing Figma designs for Minima Vue",
  "license": "MIT",
  "author": "Emre Karahan <emre.karahan@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/minima-vue/minima-vue.git",
    "directory": "minima-vue3/toolbox"
  },
  "homepage": "https://github.com/minima-vue/minima-vue/tree/main/minima-vue3/toolbox",
  "bugs": {
    "url": "https://github.com/minima-vue/minima-vue/issues"
  },
  "bin": "./bin/toolbox.js",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@svgr/core": "8.0.0",
    "@svgr/plugin-jsx": "8.0.1",
    "@svgr/plugin-prettier": "8.0.1",
    "@svgr/plugin-svgo": "8.0.1",
    "axios": "^1.13.1",
    "axios-retry": "^3.1.9",
    "commander": "^11.0.0",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.1.1",
    "get-intrinsic": "^1.3.0",
    "picocolors": "^1.1.0",
    "ts-dedent": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

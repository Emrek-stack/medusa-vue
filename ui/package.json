{
    "name": "@minima-vue/ui",
    "version": "1.0.3",
    "description": "Minima Vue components for Vue 3",
    "author": "Emre Karahan <emre.karahan@gmail.com>",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/minima-vue/minima-vue.git",
        "directory": "minima-vue3/ui"
    },
    "homepage": "https://github.com/minima-vue/minima-vue/tree/main/minima-vue3/ui",
    "bugs": {
        "url": "https://github.com/minima-vue/minima-vue/issues"
    },
    "main": "./dist/minima-vue-ui.umd.js",
    "module": "./dist/minima-vue-ui.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/minima-vue-ui.es.js",
            "require": "./dist/minima-vue-ui.umd.js"
        },
        "./style.css": "./dist/style.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "preview": "vite preview",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "@minima-vue/icons": "^1.0.3",
        "@minima-vue/ui-preset": "^1.0.3",
        "vue": "^3.4.0"
    },
    "dependencies": {
        "@radix-ui/colors": "^3.0.0",
        "@tanstack/vue-table": "^8.11.7",
        "@vueuse/core": "^10.7.2",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.0",
        "prismjs": "^1.29.0",
        "radix-vue": "^1.4.0",
        "shiki": "^1.1.0",
        "tailwind-merge": "^2.2.1",
        "vue-currency-input": "^3.0.5",
        "vue-draggable-plus": "^0.3.5"
    },
    "devDependencies": {
        "@minima-vue/icons": "file:../icons",
        "@minima-vue/ui-preset": "file:../ui-preset",
        "@storybook/addon-essentials": "^8.0.0",
        "@storybook/addon-interactions": "^8.0.0",
        "@storybook/addon-links": "^8.0.0",
        "@storybook/blocks": "^8.0.0",
        "@storybook/test": "^8.0.0",
        "@storybook/vue3": "^8.0.0",
        "@storybook/vue3-vite": "^8.0.0",
        "@types/node": "^20.11.19",
        "@types/prismjs": "^1.26.5",
        "@vitejs/plugin-vue": "^5.0.4",
        "autoprefixer": "^10.4.17",
        "postcss": "^8.4.35",
        "source-map": "^0.6.1",
        "storybook": "^8.0.0",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.9.3",
        "vite": "^5.1.3",
        "vite-plugin-dts": "^3.7.3",
        "vue": "^3.4.19",
        "vue-tsc": "^3.2.4"
    },
    "publishConfig": {
        "access": "public"
    }
}
